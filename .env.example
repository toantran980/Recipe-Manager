# =============================================
# Environment variables for local development
# Copy this file to .env and fill in your values
# .env is in .gitignore — NEVER commit it
# =============================================

# Active profile (dev for local, prod for deployment)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL connection (local or Docker)
# Format: jdbc:postgresql://host:port/database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recipe
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis (local or Docker)
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# JWT secret — Base64-encoded 256-bit key
# Generate one with: openssl rand -base64 32
JWT_SECRET=put-your-base64-256-bit-key-here